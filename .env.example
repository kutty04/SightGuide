# ==============================================================================
# SightGuide Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your local settings:
#   copy .env.example .env
#
# Research Foundation: Celona et al. (Springer, 2025)
# "Improving image captioning descriptiveness by ranking and LLM-based fusion"
# ==============================================================================

# Groq API Key for LLM-based Caption Fusion (Conservative V2 Prompt)
# Required for live LLM fusion execution (e.g., Llama-3.3-70b-versatile or Llama-3.1-8b-instant).
# If omitted or empty, the backend runs in safe dry-run mode and reports GROQ_KEY_NOT_CONFIGURED.
GROQ_API_KEY=your_groq_api_key_here

# LLM Fusion Model Configuration (Conservative V2 Policy)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=400

# FastAPI Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Allowed CORS Origins for Frontend Integration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vision-Language Models (Hugging Face Model Hub IDs or local paths)
BLIP_MODEL_NAME=Salesforce/blip-image-captioning-base
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
